{
  "name": "hanami-player",
  "private": true,
  "version": "0.3.1",
  "description": "HANAMI - local music & video player with audio-reactive Japanese typography and seasonal environments",
  "author": "Yusuff2560",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prune-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "electron:dev": "vite build && electron .",
    "electron:pack": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "motion": "^12.0.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "main": "electron/main.cjs",
  "homepage": "https://github.com/Yusuff2560/hanami-player",
  "build": {
    "appId": "com.yusuff2560.hanami",
    "productName": "HANAMI",
    "copyright": "Copyright Â© 2026 Yusuff2560",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "HANAMI",
      "artifactName": "HANAMI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HANAMI-Portable-${version}.${ext}"
    }
  }
}
